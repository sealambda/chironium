# Local development settings. Copy to envs/.env; every value is optional.

# Google sign-in, optional. Without it, use email or the development sign-in.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with the
# redirect URI http://localhost:4000/auth/user/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenID Connect sign-in, optional. Use the redirect URI
# http://localhost:4000/auth/user/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Turns on email, including email sign-in. In development any value works: mail goes
# to the local mailbox at /dev/mailbox. Remove it to try the flows without email.
RESEND_API_KEY=dev
