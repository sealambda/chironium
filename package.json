{
  "name": "chironium",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "~>24.13"
  },
  "scripts": {
    "assets:dev": "pnpm --filter chironium-assets dev",
    "assets:build": "pnpm --filter chironium-assets build",
    "assets:lint": "pnpm --filter chironium-assets lint",
    "assets:lint:fix": "pnpm --filter chironium-assets lint:fix",
    "assets:format": "pnpm --filter chironium-assets format",
    "assets:format:check": "pnpm --filter chironium-assets format",
    "assets:format:fix": "pnpm --filter chironium-assets format:fix",
    "assets:typecheck": "pnpm --filter chironium-assets typecheck",
    "assets:check": "pnpm --filter chironium-assets check",
    "assets:check:fix": "pnpm --filter chironium-assets check:fix",
    "assets:codegen": "pnpm --filter chironium-assets gql:generate",
    "assets:test": "pnpm --filter chironium-assets test",
    "assets:e2e": "pnpm --filter chironium-assets e2e",
    "assets:e2e:ui": "pnpm --filter chironium-assets e2e:ui",
    "assets:dup": "pnpm --filter chironium-assets dup",
    "assets:deadcode": "pnpm --filter chironium-assets deadcode",
    "assets:arch": "pnpm --filter chironium-assets arch",
    "assets:quality": "pnpm --filter chironium-assets quality",
    "deps:audit": "pnpm audit --prod --audit-level high",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2"
  },
  "packageManager": "pnpm@11.22.0"
}
