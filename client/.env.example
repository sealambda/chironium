# Client Environment Variables
# Copy this to .env.local for local development.

# Backend URL for full-page navigation (authentication flows).
# In development, this is the Phoenix server URL.
# In production, this should be your backend domain.
VITE_BACKEND_URL=http://localhost:4000

# API base URL for JSON:API, GraphQL, and RPC calls.
# In development, leave empty to use Vite's proxy.
# In production, set to your API endpoint (often same as BACKEND_URL).
VITE_API_BASE_URL=
