<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Security: Prevent MIME type sniffing. --%>
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <%!-- Security: Referrer policy for privacy. --%>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <%!-- PWA: Theme color for browser chrome. --%>
    <meta name="theme-color" content="#1e1b4b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <%!-- SEO: Basic meta description. --%>
    <meta
      name="description"
      content={assigns[:meta_description] || "Chironium - Health management platform"}
    />
    <.live_title default="Chironium" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <%!-- Preconnect to external resources for faster loading. --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous" />
    <PhoenixVite.Components.assets
      names={["src/main.tsx", "js/app.js", "css/app.css"]}
      manifest={{:chironium, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(ChironiumWeb.Endpoint)}
      to_url={fn p -> static_url(@conn, p) end}
      is_react?={true}
    />
    <%!-- Theme initialization script - runs before paint to prevent flash. --%>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="h-full antialiased">
    {@inner_content}
  </body>
</html>
