{
  "name": "chironium-assets",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --emit-ts-declarations --strategy cookie preferredLanguage baseLocale && tsc -b && vite build && pnpm phoenix:css-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --unsafe --write .",
    "dev": "vite dev",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "precommit": "biome check . && tsc --noEmit",
    "preview": "vite preview",
    "quality": "biome check . && tsc --noEmit && jscpd src && knip && depcruise src --config .dependency-cruiser.cjs",
    "messages:sync": "node scripts/sync-messages.mjs",
    "messages:sync:check": "node scripts/sync-messages.mjs --check",
    "typecheck": "tsc --noEmit",
    "dup": "jscpd src",
    "deadcode": "knip",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "gql:generate": "gql.tada generate output --tsconfig tsconfig.app.json",
    "gql:check": "gql.tada check --tsconfig tsconfig.app.json",
    "e2e": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:ui": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "phoenix:css-build": "tailwindcss --input css/app.css --output ../priv/static/assets/app.css --minify",
    "gql:persisted": "gql.tada generate persisted --tsconfig tsconfig.app.json --fail-on-warn --output ../priv/graphql/portal-documents.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@date-fns/tz": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@inlang/paraglide-js": "^2.19.0",
    "@posthog/react": "^1.10.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "date-fns": "^4.4.0",
    "gql.tada": "^1.11.2",
    "graphql-request": "^7.4.0",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.20.0",
    "n2words": "^5.1.0",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "posthog-js": "^1.388.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "topbar": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "daisyui": "^5.5.23",
    "dependency-cruiser": "^17.4.3",
    "graphql": "^17.0.1",
    "happy-dom": "^20.10.5",
    "jscpd": "^5.0.9",
    "knip": "^6.17.1",
    "playwright": "^1.61.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "~>24.13"
  }
}
