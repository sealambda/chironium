{
  "name": "chironium-assets",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --emit-ts-declarations --strategy cookie preferredLanguage baseLocale && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "vite dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "precommit": "biome check . && tsc --noEmit",
    "preview": "vite preview",
    "quality": "biome check . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "gql:generate": "pnpm gql:generate:tada && pnpm gql:generate:legacy",
    "gql:generate:tada": "gql.tada generate output --tsconfig tsconfig.app.json",
    "gql:generate:legacy": "graphql-codegen --config codegen.ts",
    "gql:check": "gql.tada check --tsconfig tsconfig.app.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "@inlang/paraglide-js": "^2.15.3",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/markdown": "3.20.1",
    "@tiptap/react": "3.20.1",
    "@tiptap/starter-kit": "3.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.13",
    "date-fns": "^4.1.0",
    "gql.tada": "^1.9.0",
    "graphql-request": "^7.4.0",
    "libphonenumber-js": "^1.12.37",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.3",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "topbar": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/client-preset": "^5.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.161.1",
    "@tanstack/react-router-devtools": "^1.161.1",
    "@tanstack/router-plugin": "^1.161.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "daisyui": "^5.5.18",
    "graphql": "^16.12.0",
    "happy-dom": "^20.8.9",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": "~>24.13",
    "pnpm": "~>10.33"
  }
}
