{
  "name": "chironium-assets",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --emit-ts-declarations --strategy cookie preferredLanguage baseLocale && tsc -b && vite build && pnpm phoenix:css-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --unsafe --write .",
    "dev": "vite dev",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "precommit": "biome check . && tsc --noEmit",
    "preview": "vite preview",
    "quality": "biome check . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "gql:generate": "gql.tada generate output --tsconfig tsconfig.app.json",
    "gql:check": "gql.tada check --tsconfig tsconfig.app.json",
    "e2e": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:ui": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "phoenix:css-build": "tailwindcss --input css/app.css --output ../priv/static/assets/app.css --minify"
  },
  "dependencies": {
    "@base-ui/react": "~1.4.1",
    "@fontsource-variable/inter": "~5.2.8",
    "@icons-pack/react-simple-icons": "~13.13.0",
    "@inlang/paraglide-js": "~2.16.1",
    "@posthog/react": "~1.10.2",
    "@tanstack/react-form": "~1.29.1",
    "@tanstack/react-query": "~5.100.3",
    "@tanstack/react-table": "~8.21.3",
    "@tiptap/markdown": "~3.22.4",
    "@tiptap/react": "~3.22.4",
    "@tiptap/starter-kit": "~3.22.4",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "country-flag-icons": "~1.6.16",
    "date-fns": "~4.1.0",
    "gql.tada": "~1.9.2",
    "graphql-request": "~7.4.0",
    "libphonenumber-js": "~1.12.42",
    "lucide-react": "~1.11.0",
    "n2words": "~4.0.0",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "posthog-js": "~1.388.1",
    "react": "~19.2.5",
    "react-day-picker": "~9.14.0",
    "react-dom": "~19.2.5",
    "sonner": "~2.0.7",
    "tailwind-merge": "~3.5.0",
    "topbar": "~3.0.1",
    "tw-animate-css": "~1.4.0",
    "vaul": "~1.1.2",
    "zod": "~4.3.6",
    "zustand": "~5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "~4.2.4",
    "@tailwindcss/vite": "~4.2.4",
    "@tanstack/react-query-devtools": "~5.100.3",
    "@tanstack/react-router": "~1.168.24",
    "@tanstack/react-router-devtools": "~1.166.13",
    "@tanstack/router-plugin": "~1.167.26",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "~25.6.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.1",
    "daisyui": "~5.5.19",
    "graphql": "~16.13.2",
    "happy-dom": "~20.9.0",
    "playwright": "~1.59.1",
    "shadcn": "~4.5.0",
    "tailwindcss": "~4.2.4",
    "typescript": "~6.0.3",
    "vite": "~8.0.10",
    "vitest": "~4.1.5"
  },
  "engines": {
    "node": "~>24.13"
  }
}
