{
  "name": "chironium-assets",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "paraglide-js compile --emit-ts-declarations --strategy cookie preferredLanguage baseLocale && tsc -b && vite build && pnpm phoenix:css-build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --unsafe --write .",
    "dev": "vite dev",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "precommit": "biome check . && tsc --noEmit",
    "preview": "vite preview",
    "quality": "biome check . && pnpm typecheck && jscpd src && knip && depcruise src --config .dependency-cruiser.cjs",
    "messages:sync": "node scripts/sync-messages.mjs",
    "messages:sync:check": "node scripts/sync-messages.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dup": "jscpd src",
    "deadcode": "knip",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "gql:generate": "gql.tada generate output --tsconfig tsconfig.app.json",
    "gql:check": "gql.tada check --tsconfig tsconfig.app.json",
    "e2e": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:ui": "pnpm e2e:install && PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "phoenix:css-build": "tailwindcss --input css/app.css --output ../priv/static/assets/app.css --minify",
    "gql:persisted": "gql.tada generate persisted --tsconfig tsconfig.app.json --fail-on-warn --output ../priv/graphql/portal-documents.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@inlang/paraglide-js": "^2.29.1",
    "@posthog/react": "^1.11.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.4.0",
    "gql.tada": "^1.11.4",
    "graphql-request": "^7.4.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.60.0",
    "n2words": "^6.3.0",
    "phoenix": "1.8.16",
    "phoenix_html": "4.3.0",
    "phoenix_live_view": "1.2.13",
    "posthog-js": "^1.438.13",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "topbar": "^3.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.7.50",
    "dependency-cruiser": "^18.7.0",
    "graphql": "^17.0.2",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "~>24.22"
  }
}
