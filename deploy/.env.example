# Public hostname, without scheme or port. Point its DNS at this server before starting Caddy.
PHX_HOST=chironium.example.com

# Generate each secret once and keep it stable; changing the last two signs everyone out.
# POSTGRES_PASSWORD: openssl rand -hex 32
# SECRET_KEY_BASE and TOKEN_SIGNING_SECRET: openssl rand -base64 48
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=

# Sign-in: set up at least one method. Each one is on when all its variables are set.
# Email links, through Resend. Also sends invitations and notifications from an
# address on a domain you verified with Resend.
RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=chironium@example.com
# Google. Its redirect URI is https://<PHX_HOST>/auth/user/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenID Connect, such as Keycloak or Authentik. Its redirect URI is
# https://<PHX_HOST>/auth/user/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Public demo: one-click sign-in into throwaway organizations, deleted after 24 hours.
# Never set it on an instance with real data. Leave every sign-in variable above empty.
# DEMO_MODE=true

# Image tag to run. Pin a release and read the changelog before raising it.
CHIRONIUM_VERSION=0.2.0

# Other optional settings are listed in docs/self-hosting.md.
